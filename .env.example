# Server Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Database Configuration (Primary)
# License Server Database (stores license information and tenant metadata)
LICENSE_DATABASE_URL=postgresql://username:password@localhost:5432/hrsm-licenses
# Main Application Database (stores HR business data for all tenants)
MAIN_DATABASE_URL=postgresql://username:password@localhost:5432/hrsm_platform

# PostgreSQL Connection Pool Configuration (Optional - defaults shown)
PG_MAX_POOL_SIZE=20
PG_MIN_POOL_SIZE=5
PG_IDLE_TIMEOUT=10000
PG_CONNECTION_TIMEOUT=30000

# PostgreSQL SSL Configuration (Optional - enable for production)
# PG_SSL_ENABLED=false
# PG_SSL_REJECT_UNAUTHORIZED=false
# PG_SSL_CA_PATH=/path/to/ca-certificate.crt
# PG_SSL_KEY_PATH=/path/to/client-key.key
# PG_SSL_CERT_PATH=/path/to/client-cert.crt

# JWT Configuration - Tenant Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Platform JWT Configuration - Platform Admin Authentication
PLATFORM_JWT_SECRET=your-platform-jwt-secret-different-from-tenant-secret
PLATFORM_JWT_EXPIRES_IN=30d

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Deployment Mode
DEPLOYMENT_MODE=saas
# Options: saas | on-premise

# File Upload Configuration
MAX_FILE_SIZE=10485760
# 10MB in bytes
UPLOAD_DIR=./uploads

# License Server Configuration
LICENSE_SERVER_URL=http://localhost:4000
LICENSE_SERVER_API_KEY=your-license-server-api-key-change-this-in-production
LICENSE_VALIDATION_ENABLED=true
LICENSE_VALIDATION_INTERVAL=900000
# 15 minutes in milliseconds

# Backward Compatibility Mode (for migration transition)
BACKWARD_COMPATIBILITY_MODE=false
# Set to true to enable reading from both License Server and local database during migration
PRIMARY_DATA_SOURCE=license_server
# Options: license_server | local_database (which source to try first)
LOG_DATA_SOURCE=true
# Set to false to disable logging which data source is being used
ENABLE_DATA_SOURCE_FALLBACK=true
# Set to false to disable fallback to secondary source when primary fails

# Legacy License Configuration (for on-premise deployments)
LICENSE_FILE_PATH=./config/license.json
LICENSE_SECRET_KEY=your-license-secret-key-change-this-in-production

# Email Configuration (optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@hrms.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=your-session-secret-change-this

# Logging
LOG_LEVEL=info
# Options: error | warn | info | debug

# Redis Configuration (optional - for caching)
# Enable Redis for distributed caching (improves license validation performance)
REDIS_ENABLED=false
# Set to true to enable Redis caching
REDIS_URL=redis://localhost:6379
# Redis connection URL (supports redis:// or rediss:// for TLS)

# AWS S3 (optional - for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Monitoring (optional)
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# Feature Flags (optional - override defaults)
ENABLE_FILE_UPLOADS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_AUDIT_LOGGING=true

# Security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000
# 15 minutes in milliseconds

# Pagination Defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# File Upload Restrictions
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain
MAX_FILES_PER_UPLOAD=5

# Timezone
DEFAULT_TIMEZONE=UTC

# Currency
DEFAULT_CURRENCY=USD

# Language
DEFAULT_LANGUAGE=en
