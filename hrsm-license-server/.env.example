# Server Configuration
PORT=4000
NODE_ENV=production

# PostgreSQL Database Configuration (Primary)
# License Server Database (stores license information and tenant metadata)
# Format: postgresql://username:password@host:port/database
LICENSE_DATABASE_URL=postgresql://username:password@localhost:5432/hrsm-licenses

# PostgreSQL Connection Pool Configuration (Optional - defaults shown)
PG_MAX_POOL_SIZE=10
PG_MIN_POOL_SIZE=2
PG_IDLE_TIMEOUT=10000
PG_CONNECTION_TIMEOUT=30000

# PostgreSQL SSL Configuration (Optional - enable for production)
# PG_SSL_ENABLED=false
# PG_SSL_REJECT_UNAUTHORIZED=false

# Database - MongoDB (DEPRECATED - Migration to PostgreSQL complete)
# MONGODB_URI=mongodb+srv://your_license_db_user:your_license_db_password@cluster.uwhj601.mongodb.net/hrsm-licenses?retryWrites=true&w=majority

# RSA Keys
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Security
ADMIN_API_KEY=generate-secure-key-here
ALLOWED_ORIGINS=http://localhost:5000,https://your-hrms-domain.com
ENFORCE_HTTPS=true

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100