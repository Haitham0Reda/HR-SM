# ============================================================================
# HR-SM License Server - Standalone Microservice Configuration
# ============================================================================

# Server Configuration
PORT=4000
NODE_ENV=production
LOG_LEVEL=info

# ============================================================================
# PostgreSQL Database Configuration (Separate from Main App)
# ============================================================================
# License Server uses its own dedicated PostgreSQL database
# This is SEPARATE from the main HR-SM application database

# Option 1: Full Database URL (Recommended)
LICENSE_DATABASE_URL=postgresql://license_user:license_password@localhost:5432/hrsm_licenses

# Option 2: Individual Components (Fallback if URL not provided)
LICENSE_DB_HOST=localhost
LICENSE_DB_PORT=5432
LICENSE_DB_NAME=hrsm_licenses
LICENSE_DB_USER=license_user
LICENSE_DB_PASSWORD=license_password

# PostgreSQL Connection Pool Configuration
PG_MAX_POOL_SIZE=10
PG_MIN_POOL_SIZE=2
PG_IDLE_TIMEOUT=10000
PG_CONNECTION_TIMEOUT=30000

# PostgreSQL SSL Configuration (Enable for production)
# PG_SSL_ENABLED=false
# PG_SSL_REJECT_UNAUTHORIZED=false

# ============================================================================
# RSA Keys for JWT Signing
# ============================================================================
# Generate keys using: npm run generate-keys
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# ============================================================================
# Security Configuration
# ============================================================================
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3001,https://your-hrms-domain.com

# ============================================================================
# Docker Configuration (Optional)
# ============================================================================
# When running in Docker, use these settings:
# LICENSE_DATABASE_URL=postgresql://license_user:license_password@postgres:5432/hrsm_licenses
# JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
# JWT_PUBLIC_KEY_PATH=/app/keys/public.pem